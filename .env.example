# ── Copy this file to .env and fill in your values ────────────────────────────
# .env is git-ignored. Never commit real credentials.

# ── Sprint / target ────────────────────────────────────────────────────────────
SPRINT_NAME=Sprint 42
TARGET_ENV=QA                      # QA | UAT | PROD

# ── ADO connection ─────────────────────────────────────────────────────────────
ADO_ORG=learnondemandsystems        # your org name from the ADO URL
ADO_PROJECT=Lab On Demand           # your project name

# ── Auth mode ──────────────────────────────────────────────────────────────────
# 'pat'   → Personal Access Token (easiest for local dev)
# 'entra' → Entra ID service principal (recommended for production)
AUTH_MODE=pat

# PAT token (when AUTH_MODE=pat)
# Generate: ADO → User Settings → Personal Access Tokens
# Scopes needed: Test Plans (Read & Write), Work Items (Read)
ADO_PAT=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Entra ID service principal (when AUTH_MODE=entra)
# az ad sp create-for-rbac --name "ado-ai-test-runner"
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Application login ──────────────────────────────────────────────────────────
STUDIO_URL=https://admin.qa.skillable.com
APP_AUTH_MODE=credentials           # 'credentials' or 'entra'
APP_USERNAME=your-test-user@skillable.com
APP_PASSWORD=YourTestPassword123!

# ── Claude AI ─────────────────────────────────────────────────────────────────
# Get from: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
